#!/usr/bin/env php
<?php

error_reporting(0);

$autoloadPaths = [
    'development' => sprintf('%s/vendor/autoload.php', dirname(__DIR__)),
    'installed' => sprintf('%s/autoload.php', dirname(__DIR__, 3)),
];

if (file_exists($autoloadPaths['installed'])) {
    require_once $autoloadPaths['installed'];
} elseif (file_exists($autoloadPaths['development'])) {
    require_once $autoloadPaths['development'];
} else {
    throw new \RuntimeException('Autoloader not found');
}

use App\DatabaseService;
use App\Server;

$configPath = $argv[1] ?? null;

if ($configPath === null) {
    fwrite(STDERR, "Usage: app <config.yaml>\n");
    exit(1);
}

$configYaml = file_get_contents($configPath);

if (!is_string($configYaml)) {
    fwrite(STDERR, "Config file not found: {$configPath}\n");
    exit(1);
}

/**
 * @var array<string, mixed> $config
 */
$config = yaml_parse($configYaml);
$dbService = new DatabaseService($config);
$server = new Server($dbService);

$server->listen();