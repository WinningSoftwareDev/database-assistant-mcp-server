{
    "name": "winningsoftware/database-assistant-mcp-server",
    "description": "A PHP based MCP server for querying SQL databases.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Daniel Winning",
            "email": "daniel@winningsoftware.co.uk"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "bin": ["bin/database-assistant-mcp-server"],
    "require": {
        "php": "^8.4",
        "ext-yaml": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "cs": "./vendor/bin/php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "stan": "php -d memory_limit=2G ./vendor/bin/phpstan analyse -c phpstan.neon"
    }
}
